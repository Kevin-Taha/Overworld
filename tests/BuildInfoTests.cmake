cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED GENERATOR_DIR OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "Build identity tests require GENERATOR_DIR and TEST_ROOT.")
endif()

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef fixture_id)
set(fixture "${TEST_ROOT}/fixture-${fixture_id}")
file(MAKE_DIRECTORY "${fixture}/src" "${fixture}/cmake" "${fixture}/out")
file(COPY "${GENERATOR_DIR}/WriteBuildInfo.cmake" "${GENERATOR_DIR}/BuildInfo.h.in"
    DESTINATION "${fixture}/cmake")
file(WRITE "${fixture}/CMakeLists.txt" "project(BuildInfoFixture VERSION 0.2.0)\n")
file(WRITE "${fixture}/src/Main.cpp" "int fixture_value = 1;\n")
set(header "${fixture}/out/BuildInfo.h")
set(fixture_git "${fixture}/missing-git")

function(generate arch config)
    set(flavor voice-off)
    if(ARGC GREATER 2)
        set(flavor "${ARGV2}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DSOURCE_DIR=${fixture}" "-DOUTPUT_FILE=${header}" "-DAPP_VERSION=0.2.0"
        "-DBUILD_ARCH=${arch}" "-DBUILD_CONFIG=${config}" "-DGIT_EXECUTABLE=${fixture_git}"
        "-DBUILD_FLAVOR=${flavor}"
        -P "${fixture}/cmake/WriteBuildInfo.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Build identity generation failed: ${output}${errors}")
    endif()
    file(READ "${header}" content)
    set(generated "${content}" PARENT_SCOPE)
    set(warnings "${errors}" PARENT_SCOPE)
endfunction()

generate(x64 Release)
set(original "${generated}")
if(NOT original MATCHES "0\\.2\\.0\\+unversioned\\.src\\.[0-9a-f]+\\.x64\\.Release"
   OR NOT warnings MATCHES "unversioned")
    message(FATAL_ERROR "Missing Git must yield an explicit unversioned label and warning.")
endif()
if(NOT original MATCHES "#define GAMEPAD_BUILD_VERSION 0,2,0,0")
    message(FATAL_ERROR "The numeric resource version must preserve the semantic version.")
endif()
file(TIMESTAMP "${header}" original_time "%s" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1 COMMAND_ERROR_IS_FATAL ANY)
generate(x64 Release)
file(TIMESTAMP "${header}" repeated_time "%s" UTC)
if(NOT generated STREQUAL original OR NOT repeated_time STREQUAL original_time)
    message(FATAL_ERROR "Unchanged inputs rewrote the header or changed its content.")
endif()

file(APPEND "${fixture}/src/Main.cpp" "int changed_source = 2;\n")
generate(x64 Release)
if(generated STREQUAL original)
    message(FATAL_ERROR "A relevant source change did not update the identity.")
endif()
set(source_changed "${generated}")
file(WRITE "${fixture}/src/Added.h" "#pragma once\n")
generate(x64 Release)
if(generated STREQUAL source_changed)
    message(FATAL_ERROR "A new source input did not update the identity.")
endif()
file(REMOVE "${fixture}/src/Added.h")
generate(x64 Release)
if(NOT generated STREQUAL source_changed)
    message(FATAL_ERROR "Removing the new input did not restore the previous identity.")
endif()

file(APPEND "${fixture}/CMakeLists.txt" "# Changed build input\n")
generate(x64 Release)
if(generated STREQUAL source_changed)
    message(FATAL_ERROR "A CMakeLists change did not update the identity.")
endif()
set(cmake_changed "${generated}")
file(APPEND "${fixture}/cmake/BuildInfo.h.in" "\n")
generate(x64 Release)
string(REGEX MATCH "src\\.[0-9a-f]+" old_hash "${cmake_changed}")
if(generated MATCHES "${old_hash}")
    message(FATAL_ERROR "A CMake template change did not update the source fingerprint.")
endif()
set(current "${generated}")

file(MAKE_DIRECTORY "${fixture}/cmake/WhisperLibrary")
foreach(build_input cmake/BuildWhisperLibrary.ps1 cmake/WhisperLibrary/CMakeLists.txt)
    file(WRITE "${fixture}/${build_input}" "# Isolated dependency build input\n")
    generate(x64 Release)
    if(generated STREQUAL current)
        message(FATAL_ERROR "An isolated dependency build input did not update the identity: ${build_input}")
    endif()
    set(current "${generated}")
endforeach()

file(MAKE_DIRECTORY "${fixture}/third_party")
file(WRITE "${fixture}/third_party/PredictionVocabulary.inc" "\"example\",\n")
generate(x64 Release)
if(generated STREQUAL current)
    message(FATAL_ERROR "Embedded prediction data did not update the source fingerprint.")
endif()
set(current "${generated}")
file(APPEND "${fixture}/third_party/PredictionVocabulary.inc" "\"another\",\n")
generate(x64 Release)
if(generated STREQUAL current)
    message(FATAL_ERROR "A vocabulary data change did not update the source fingerprint.")
endif()
set(current "${generated}")

file(WRITE "${fixture}/README.md" "Unrelated documentation\n")
file(WRITE "${fixture}/out/unused.cpp" "Build output must not be hashed\n")
file(WRITE "${fixture}/src/local.txt" "Unrelated local data must not be hashed\n")
generate(x64 Release)
if(NOT generated STREQUAL current)
    message(FATAL_ERROR "An unrelated file or build output changed the identity.")
endif()
generate(ARM64 Release)
if(generated STREQUAL current OR NOT generated MATCHES "\\.ARM64\\.Release")
    message(FATAL_ERROR "Architecture is not distinguished.")
endif()
generate(x64 Debug)
if(generated STREQUAL current OR NOT generated MATCHES "\\.x64\\.Debug")
    message(FATAL_ERROR "Configuration is not distinguished.")
endif()
generate(x64 Release voice-portable)
set(portable "${generated}")
if(portable STREQUAL current OR NOT portable MATCHES "\\.Release\\.voice-portable")
    message(FATAL_ERROR "Portable speech feature must differ from the voice-off artifact.")
endif()
generate(x64 Release voice-avx2)
if(generated STREQUAL portable OR NOT generated MATCHES "\\.Release\\.voice-avx2")
    message(FATAL_ERROR "AVX2 speech artifact must have an explicit distinct identity.")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DSOURCE_DIR=${fixture}" "-DOUTPUT_FILE=${header}" "-DAPP_VERSION=0.2.0"
    "-DBUILD_ARCH=x64" "-DBUILD_CONFIG=Release" "-DBUILD_FLAVOR=C:\\private\\model.bin"
    "-DGIT_EXECUTABLE=${fixture_git}" -P "${fixture}/cmake/WriteBuildInfo.cmake"
    RESULT_VARIABLE unsafe_flavor OUTPUT_QUIET ERROR_QUIET)
if(unsafe_flavor STREQUAL "0")
    message(FATAL_ERROR "User paths must never be accepted as build flavor identity.")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DSOURCE_DIR=${fixture}" "-DOUTPUT_FILE=${header}" "-DAPP_VERSION=0.2.0"
    "-DBUILD_ARCH=x64" "-DBUILD_CONFIG=unsafe\"configuration"
    "-DGIT_EXECUTABLE=${fixture_git}" -P "${fixture}/cmake/WriteBuildInfo.cmake"
    RESULT_VARIABLE unsafe_result OUTPUT_QUIET ERROR_VARIABLE unsafe_error)
if(unsafe_result STREQUAL "0" OR NOT unsafe_error MATCHES "ASCII configuration")
    message(FATAL_ERROR "Unsafe configuration text must fail instead of entering compiler/resource strings.")
endif()
file(READ "${header}" after_unsafe)
if(NOT after_unsafe STREQUAL generated)
    message(FATAL_ERROR "Invalid input modified the existing header.")
endif()

find_program(real_git NAMES git)
if(real_git)
    set(fixture_git "${real_git}")
    generate(x64 Release)
    if(NOT generated STREQUAL current OR NOT warnings MATCHES "unversioned")
        message(FATAL_ERROR "A source export must not inherit an enclosing repository's revision.")
    endif()
else()
    message(STATUS "Git not installed; enclosing-repository export check skipped.")
endif()

# The randomly named directory and all its contents are owned by this invocation.
file(REMOVE_RECURSE "${fixture}")
message(STATUS "Build identity tests passed: stable content/mtime, source/add/remove/CMake/template changes, exclusions, arch/config, unversioned exports, safe strings.")
