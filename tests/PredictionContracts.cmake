cmake_minimum_required(VERSION 3.24)
foreach(name WordPrediction KeyboardDelivery PredictionTarget TextDelivery)
    file(READ "${SOURCE_DIR}/src/${name}.cpp" source)
    if(source MATCHES "(GetWindowText[A-Z]*|GetWindowTextLength[A-Z]*|SendMessage[A-Z]*|SendMessageTimeout[A-Z]*|OpenClipboard|GetClipboardData|SetClipboardData|CreateFile[A-Z]*|WriteFile|OutputDebugString[A-Z]*|GetAsyncKeyState|GetKeyState|SetWindowsHookEx[A-Z]*)\\(")
        message(FATAL_ERROR "${name} must not read target text, log/persist fragments or collect physical keystrokes.")
    endif()
    if(source MATCHES "EM_GETSEL|EM_GETTEXT|UIAutomation|IUIAutomation|PredictionTargetWorker|prediction_trust|Hold Down to enable|privacy unverified")
        message(FATAL_ERROR "${name} reintroduced target RPC, consent or warning-level UI.")
    endif()
endforeach()
file(READ "${SOURCE_DIR}/src/Host.cpp" host)
if(host MATCHES "prediction-preview|prediction-demo|word-prediction|\\.prefix\\(\\)|practice_sample")
    message(FATAL_ERROR "Shipping Host must not expose prediction prototypes or inspect/log fragments.")
endif()
file(READ "${SOURCE_DIR}/src/PredictionTarget.cpp" target)
if(NOT target MATCHES "ES_PASSWORD" OR NOT target MATCHES "PredictionPrivacy::Unknown")
    message(FATAL_ERROR "Keep negative known-password evidence without positive privacy claims.")
endif()
message(STATUS "Prediction contracts: bounded own-edit components, no target text/clipboard/RPC or persistence, no consent UI")
