file(READ "${SOURCE_DIR}/src/Host.cpp" host)
string(FIND "${host}" "CreateMutexW(nullptr, TRUE, L\"Local\\\\GamepadDesktop.M1.SingleMapper\")" guard)
string(FIND "${host}" "} else if (practice) {" practice)
string(FIND "${host}" "Host host(inspection);" live)
if(guard LESS 0 OR practice LESS guard OR live LESS practice)
    message(FATAL_ERROR "Practice must branch after the shared guard and before any Host construction")
endif()
string(SUBSTRING "${host}" ${practice} -1 branch)
string(FIND "${branch}" "} else if (keyboard_preview)" end)
string(SUBSTRING "${branch}" 0 ${end} branch)
if(NOT branch MATCHES "gamepad::practice::run\\(instance, show, reader\\)"
   OR branch MATCHES "(Host host|Desktop|NativeVoice|NativeCursor|NavigationFilter|ControllerPoller)")
    message(FATAL_ERROR "Practice entry must only construct an observation-only reader and its owned scene")
endif()
foreach(file Practice.h Practice.cpp PracticeWindow.h PracticeWindow.cpp PracticeVisual.h PracticeVisual.cpp)
    file(READ "${SOURCE_DIR}/src/${file}" content)
    if(content MATCHES "#include \"(Desktop|Live|NativeVoice|NativeCursorVisibility|NativeNavigationFilter|KeyboardDelivery|TextDelivery|Settings|XInputReader)\\.h\""
       OR content MATCHES "(SendInput|SetWindowsHookEx[A-Z]*|ShowCursor|SetCursorPos|ClipCursor|SetForegroundWindow|SetFocus|SetClipboardData|OpenClipboard|RegisterRawInputDevices|XInputGetState|CreateFileW|WriteFile|RegSetValueExW)\\(")
        message(FATAL_ERROR "${file}: practice acquired a forbidden live input, global observer, or persistence boundary")
    endif()
endforeach()
message(STATUS "Practice source/launch isolation passed; render helper links no desktop, XInput, microphone, or hook adapters")
