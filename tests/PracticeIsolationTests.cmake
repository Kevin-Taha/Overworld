cmake_minimum_required(VERSION 3.24)
file(READ "${SOURCE_DIR}/src/Host.cpp" host)
file(READ "${SOURCE_DIR}/src/PracticeHost.cpp" harness)
file(READ "${SOURCE_DIR}/src/InstanceGuard.h" guard)
if(host MATCHES "[Pp]ractice")
    message(FATAL_ERROR "Shipping Host must not contain development practice code or CLI routing.")
endif()
file(READ "${SOURCE_DIR}/src/KeyboardPreview.cpp" preview)
if(host MATCHES "prediction-preview|prediction-demo" OR preview MATCHES "PredictionPractice")
    message(FATAL_ERROR "Prediction practice fixtures must not become shipping product modes.")
endif()
if(NOT guard MATCHES "Local\\\\\\\\GamepadDesktop.M1.SingleMapper")
    message(FATAL_ERROR "Shared instance guard identity must stay compatible with existing mapper releases.")
endif()
foreach(entry host harness)
    string(FIND "${${entry}}" "MapperInstanceGuard singleton" guarded)
    string(FIND "${${entry}}" "return 2;" invalid)
    if(invalid LESS 0 OR guarded LESS invalid)
        message(FATAL_ERROR "${entry} must reject invalid CLI before acquiring a guard or starting input.")
    endif()
endforeach()
string(FIND "${harness}" "Reader reader(" reader)
string(FIND "${harness}" "!singleton.acquired()" acquired)
if(acquired LESS 0 OR reader LESS acquired OR harness MATCHES "(Host host|NativeVoice|NativeCursor|NavigationFilter|ControllerPoller)")
    message(FATAL_ERROR "Development entry must guard before constructing its observation-only reader.")
endif()
include("${TARGET_CONTRACT}")
if(NOT harness_excluded)
    message(FATAL_ERROR "Development exe must stay outside the default build.")
endif()
foreach(target IN LISTS shipping_targets)
    if(target MATCHES "[Pp]ractice")
        message(FATAL_ERROR "Shipping target links practice module: ${target}")
    endif()
endforeach()
foreach(shared gamepad_core gamepad_keyboard gamepad_keyboard_visual gamepad_app_ui gamepad_cursor_pixels gamepad_xinput)
    if(NOT shared IN_LIST shipping_targets OR NOT shared IN_LIST harness_targets)
        message(FATAL_ERROR "Missing shared production component: ${shared}")
    endif()
endforeach()
if("gamepad_xinput" IN_LIST render_targets)
    message(FATAL_ERROR "Render helper must not link XInput.")
endif()
foreach(file Practice.h Practice.cpp PracticeWindow.h PracticeWindow.cpp PracticeVisual.h PracticeVisual.cpp PracticeReader.h PracticeReader.cpp)
    file(READ "${SOURCE_DIR}/src/${file}" content)
    if(content MATCHES "#include \"(Desktop|Live|NativeVoice|NativeCursorVisibility|NativeNavigationFilter|KeyboardDelivery|TextDelivery|Settings|XInputReader)\\.h\""
       OR content MATCHES "(SendInput|SetWindowsHookEx[A-Z]*|ShowCursor|SetCursorPos|ClipCursor|SetForegroundWindow|SetFocus|SetClipboardData|OpenClipboard|RegisterRawInputDevices|XInputGetState|CreateFileW|WriteFile|RegSetValueExW)\\(")
        message(FATAL_ERROR "${file}: practice acquired a forbidden live input, global observer, or persistence boundary")
    endif()
endforeach()
message(STATUS "Development-only harness contracts passed: shared production libraries, separate guarded entry, no shipping linkage or render-helper input")
