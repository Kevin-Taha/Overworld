# Explicit opt-in: ordinary builds do not download or require speech dependencies.
option(GAMEPAD_VOICE_WHISPER "Build local CPU dictation with pinned whisper.cpp" OFF)
option(GAMEPAD_VOICE_AVX2 "Require AVX2/FMA/F16C/BMI2 for faster x64 voice (not portable)" OFF)
set(GAMEPAD_WHISPER_ROOT "" CACHE PATH "Isolated clang-cl Release /MT Whisper package (required for MSVC ARM64 voice)")
if(GAMEPAD_VOICE_WHISPER AND GAMEPAD_WHISPER_ROOT)
    include("${CMAKE_CURRENT_LIST_DIR}/ImportWhisperLibrary.cmake")
    return()
endif()
if(GAMEPAD_VOICE_WHISPER AND CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64" AND CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    message(FATAL_ERROR "ARM64 voice requires the isolated clang-cl library. Run cmake/BuildWhisperLibrary.ps1, then configure with -DGAMEPAD_WHISPER_ROOT=<build>/package -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded -DCMAKE_CONFIGURATION_TYPES=Release. The application stays on MSVC; voice is never silently disabled.")
endif()
if(GAMEPAD_VOICE_WHISPER)
    include(FetchContent)
    set(WHISPER_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(WHISPER_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(WHISPER_BUILD_SERVER OFF CACHE BOOL "" FORCE)
    set(WHISPER_CURL OFF CACHE BOOL "" FORCE)
    set(GGML_CUDA OFF CACHE BOOL "" FORCE)
    set(GGML_VULKAN OFF CACHE BOOL "" FORCE)
    set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
    # Portable x64 baseline; do not emit AVX2 instructions into an otherwise runnable app.
    foreach(feature GGML_SSE42 GGML_AVX GGML_AVX2 GGML_FMA GGML_F16C GGML_BMI2)
        set(${feature} OFF CACHE BOOL "" FORCE)
    endforeach()
    if(GAMEPAD_VOICE_AVX2 AND CMAKE_GENERATOR_PLATFORM STREQUAL "x64")
        foreach(feature GGML_SSE42 GGML_AVX GGML_AVX2 GGML_FMA GGML_F16C GGML_BMI2)
            set(${feature} ON CACHE BOOL "" FORCE)
        endforeach()
        message(STATUS "Local voice requires AVX2/FMA/F16C/BMI2; portable application code retains its baseline")
    endif()
    set(GGML_CCACHE OFF CACHE BOOL "" FORCE)
    set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
    set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(whisper
        URL https://codeload.github.com/ggml-org/whisper.cpp/zip/a8d002cfd879315632a579e73f0148d06959de36
        URL_HASH SHA256=4f02191b61135324a80137e459cd239e037ef3852bad4e6a2ea69490f3d89490
        DOWNLOAD_EXTRACT_TIMESTAMP TRUE
        TIMEOUT 60)
    FetchContent_MakeAvailable(whisper)
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/voice-licenses")
    configure_file("${whisper_SOURCE_DIR}/LICENSE" "${CMAKE_CURRENT_BINARY_DIR}/voice-licenses/whisper.cpp-LICENSE.txt" COPYONLY)
endif()
