include("${CMAKE_CURRENT_LIST_DIR}/../BuildOptions.cmake")
set(CMAKE_SYSTEM_NAME Windows)
if(OVERWORLD_WHISPER_ARCH STREQUAL "ARM64")
    set(CMAKE_SYSTEM_PROCESSOR ARM64)
    set(whisper_triple aarch64-pc-windows-msvc)
elseif(OVERWORLD_WHISPER_ARCH STREQUAL "x64")
    set(CMAKE_SYSTEM_PROCESSOR AMD64)
    set(whisper_triple x86_64-pc-windows-msvc)
else()
    message(FATAL_ERROR "OVERWORLD_WHISPER_ARCH must be ARM64 or x64")
endif()
set(CMAKE_C_COMPILER "${OVERWORLD_LLVM_ROOT}/bin/clang-cl.exe")
set(CMAKE_CXX_COMPILER "${OVERWORLD_LLVM_ROOT}/bin/clang-cl.exe")
set(CMAKE_C_COMPILER_TARGET "${whisper_triple}")
set(CMAKE_CXX_COMPILER_TARGET "${whisper_triple}")
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES OVERWORLD_WHISPER_ARCH OVERWORLD_LLVM_ROOT)
