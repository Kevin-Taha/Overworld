file(MAKE_DIRECTORY "${PACKAGE_DIR}/lib" "${PACKAGE_DIR}/include")
file(COPY_FILE "${WHISPER_LIB}" "${PACKAGE_DIR}/lib/whisper.lib" ONLY_IF_DIFFERENT)
file(COPY_FILE "${GGML_LIB}" "${PACKAGE_DIR}/lib/ggml.lib" ONLY_IF_DIFFERENT)
file(COPY_FILE "${GGML_CPU_LIB}" "${PACKAGE_DIR}/lib/ggml-cpu.lib" ONLY_IF_DIFFERENT)
file(COPY_FILE "${GGML_BASE_LIB}" "${PACKAGE_DIR}/lib/ggml-base.lib" ONLY_IF_DIFFERENT)
file(COPY "${WHISPER_SOURCE}/include/whisper.h" DESTINATION "${PACKAGE_DIR}/include")
file(COPY "${WHISPER_SOURCE}/ggml/include/" DESTINATION "${PACKAGE_DIR}/include" FILES_MATCHING PATTERN "*.h")
file(COPY_FILE "${WHISPER_SOURCE}/LICENSE" "${PACKAGE_DIR}/whisper.cpp-LICENSE.txt" ONLY_IF_DIFFERENT)
# Version-1 package keys are a compatibility format, not public build-option names.
set(manifest "set(GAMEPAD_WHISPER_PACKAGE_VERSION 1)\nset(GAMEPAD_WHISPER_ARCH ${ARCH})\nset(GAMEPAD_WHISPER_COMMIT a8d002cfd879315632a579e73f0148d06959de36)\nset(GAMEPAD_WHISPER_LLVM ${LLVM_VERSION})\nset(GAMEPAD_WHISPER_CRT MultiThreaded)\n")
string(APPEND manifest "set(GAMEPAD_WHISPER_MSVC_ABI ${MSVC_ABI_VERSION})\nset(GAMEPAD_WHISPER_ARCHIVE_SHA256 4f02191b61135324a80137e459cd239e037ef3852bad4e6a2ea69490f3d89490)\n")
file(GLOB_RECURSE files RELATIVE "${PACKAGE_DIR}" "${PACKAGE_DIR}/lib/*.lib" "${PACKAGE_DIR}/include/*.h")
list(APPEND files whisper.cpp-LICENSE.txt)
string(APPEND manifest "set(GAMEPAD_WHISPER_FILES \"${files}\")\n")
foreach(relative IN LISTS files)
    file(SHA256 "${PACKAGE_DIR}/${relative}" hash)
    string(APPEND manifest "set(\"GAMEPAD_WHISPER_SHA256_${relative}\" ${hash})\n")
endforeach()
file(WRITE "${PACKAGE_DIR}/manifest.cmake" "${manifest}")
