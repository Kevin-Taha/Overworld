overworld_target_closure(overworld_controller_view_window view_targets)
if(NOT "overworld_controller_view_window" IN_LIST shipping_targets
   OR NOT "overworld_controller_view_visual" IN_LIST view_targets
   OR NOT "overworld_keyboard_visual" IN_LIST view_targets)
    message(FATAL_ERROR "Optional controller view must share its exact renderer and keyboard appearance with the product.")
endif()
foreach(target overworld_xinput overworld_voice overworld_navigation overworld_ring overworld_settings)
    if(target IN_LIST view_targets)
        message(FATAL_ERROR "Read-only controller visualization must not link ${target}.")
    endif()
endforeach()
foreach(target overworld_controller_view_window overworld_controller_view_visual)
    if(target IN_LIST harness_targets)
        message(FATAL_ERROR "Practice cannot acquire the product controller view's independent window.")
    endif()
endforeach()
get_property(local_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
foreach(spec "ControllerViewVisual.cpp|overworld_controller_view_visual"
    "ControllerViewWindow.cpp|overworld_controller_view_window")
    string(REPLACE "|" ";" pair "${spec}")
    list(GET pair 0 file)
    list(GET pair 1 owner)
    foreach(target IN LISTS local_targets)
        get_target_property(sources "${target}" SOURCES)
        foreach(source IN LISTS sources)
            get_filename_component(name "${source}" NAME)
            if(name STREQUAL file AND NOT target STREQUAL owner)
                message(FATAL_ERROR "${file} must compile once in ${owner}, not separately in ${target}.")
            endif()
        endforeach()
    endforeach()
endforeach()
foreach(file ControllerViewWindow.cpp ControllerViewVisual.cpp)
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/src/${file}" content)
    if(content MATCHES "#include \"(Desktop|Live|NativeVoice|NativeCursorVisibility|NativeNavigationFilter|Settings|XInputReader|NativeControllers)\\.h\""
       OR content MATCHES "(SendInput|mouse_event|keybd_event|XInputGetState|DirectInput8Create|RegisterRawInputDevices|SetWindowsHookEx[A-Z]*|SetForegroundWindow|SetFocus|ShowCursor|SetCursorPos|ClipCursor|OpenClipboard|SetClipboardData|RegSetValueExW)\\(")
        message(FATAL_ERROR "${file}: read-only visualization acquired a native input, focus, cursor, clipboard or settings boundary.")
    endif()
endforeach()

file(READ "${CMAKE_CURRENT_SOURCE_DIR}/src/Host.cpp" host)
if(NOT host MATCHES "std::unique_ptr<ControllerViewWindow> controller_view_;"
   OR NOT host MATCHES "if \\(show_controller_view\\) \\{[ \r\n]+try \\{[ \r\n]+controller_view_ = std::make_unique<ControllerViewWindow>"
   OR NOT host MATCHES "if \\(!controller_view_\\) \\{ return; \\}")
    message(FATAL_ERROR "Controller view must be lazily allocated after explicit launch authorization, with an inactive update fast path.")
endif()
string(REGEX MATCHALL "make_unique<ControllerViewWindow>" constructions "${host}")
list(LENGTH constructions count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Host must have exactly one explicitly gated controller view construction site.")
endif()

if(BUILD_TESTING)
    get_property(default_tests DIRECTORY PROPERTY TESTS)
    foreach(target overworld_controller_view_visual_tests overworld_controller_view_window_tests)
        get_target_property(excluded "${target}" EXCLUDE_FROM_ALL)
        if(NOT excluded OR target IN_LIST default_tests)
            message(FATAL_ERROR "${target} creates native rendering resources and must remain explicit opt-in.")
        endif()
    endforeach()
    overworld_target_closure(overworld_controller_view_window_tests window_test_targets)
    if(NOT "overworld_controller_view_window" IN_LIST window_test_targets
       OR "overworld_xinput" IN_LIST window_test_targets)
        message(FATAL_ERROR "Hidden controller view fixture must use the actual product window without a controller reader.")
    endif()
endif()
