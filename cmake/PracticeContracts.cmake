# Keep development demonstrations on the actual shipping components, not source copies.
function(overworld_target_closure root output)
    set(pending "${root}")
    set(visited "")
    while(pending)
        list(POP_FRONT pending target)
        if(target IN_LIST visited)
            continue()
        endif()
        list(APPEND visited "${target}")
        get_target_property(links "${target}" LINK_LIBRARIES)
        foreach(link IN LISTS links)
            if(TARGET "${link}")
                list(APPEND pending "${link}")
            endif()
        endforeach()
    endwhile()
    set("${output}" "${visited}" PARENT_SCOPE)
endfunction()

overworld_target_closure(Overworld shipping_targets)
overworld_target_closure(OverworldPractice harness_targets)
foreach(target IN LISTS shipping_targets)
    if(target MATCHES "[Pp]ractice")
        message(FATAL_ERROR "Shipping Overworld must not depend on ${target}.")
    endif()
    get_target_property(sources "${target}" SOURCES)
    foreach(source IN LISTS sources)
        if(source MATCHES "(^|[/\\\\])Practice[^/\\\\]*\\.(cpp|h)$")
            message(FATAL_ERROR "Shipping dependency ${target} contains development source ${source}.")
        endif()
    endforeach()
endforeach()
foreach(target overworld_core overworld_keyboard overworld_keyboard_visual overworld_app_ui overworld_cursor_pixels overworld_xinput overworld_controller_model)
    if(NOT target IN_LIST shipping_targets OR NOT target IN_LIST harness_targets)
        message(FATAL_ERROR "Shipping app and development harness must share ${target}.")
    endif()
endforeach()
foreach(target overworld_voice overworld_navigation overworld_ring overworld_settings)
    if(target IN_LIST harness_targets)
        message(FATAL_ERROR "Development harness must not acquire ${target}'s native/persistent boundaries.")
    endif()
endforeach()
get_target_property(harness_excluded OverworldPractice EXCLUDE_FROM_ALL)
if(NOT harness_excluded)
    message(FATAL_ERROR "OverworldPractice must be an explicit development-only target.")
endif()

get_property(local_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
foreach(target IN LISTS local_targets)
    get_target_property(excluded "${target}" EXCLUDE_FROM_ALL)
    if(NOT excluded)
        overworld_target_closure("${target}" default_targets)
        foreach(dependency IN LISTS default_targets)
            if(dependency MATCHES "[Pp]ractice")
                message(FATAL_ERROR "Default target ${target} must not pull development dependency ${dependency} into ALL_BUILD.")
            endif()
        endforeach()
    endif()
endforeach()
foreach(spec "Pointer.cpp|overworld_core" "Keyboard.cpp|overworld_keyboard" "WordPrediction.cpp|overworld_keyboard"
    "KeyboardVisual.cpp|overworld_keyboard_visual" "KeyboardAppearance.cpp|overworld_keyboard_visual"
    "KeyboardPopup.cpp|overworld_keyboard_popup"
    "KeyboardShell.cpp|overworld_keyboard_popup" "KeyboardPlacement.cpp|overworld_keyboard_placement" "AppUi.cpp|overworld_app_ui"
    "RingPixels.cpp|overworld_cursor_pixels" "XInputReader.cpp|overworld_xinput" "NativeControllers.cpp|overworld_xinput"
    "ControllerMapping.cpp|overworld_controller_model" "ControllerDevices.cpp|overworld_controller_model"
    "ControllerDiscovery.cpp|overworld_controller_model")
    string(REPLACE "|" ";" pair "${spec}")
    list(GET pair 0 file)
    list(GET pair 1 owner)
    foreach(target IN LISTS local_targets)
        get_target_property(sources "${target}" SOURCES)
        foreach(source IN LISTS sources)
            get_filename_component(name "${source}" NAME)
            if(name STREQUAL file AND NOT target STREQUAL owner)
                message(FATAL_ERROR "${file} must compile once in ${owner}, not separately in ${target}.")
            endif()
        endforeach()
    endforeach()
endforeach()
if(BUILD_TESTING)
    foreach(target overworld_practice_visual_tests overworld_keyboard_visual_tests)
        overworld_target_closure("${target}" test_targets)
        if(NOT "overworld_keyboard_visual" IN_LIST test_targets)
            message(FATAL_ERROR "${target} must exercise the production keyboard renderer library.")
        endif()
    endforeach()
    overworld_target_closure(overworld_practice_visual_tests render_targets)
    if(NOT "overworld_practice_view" IN_LIST render_targets OR "overworld_xinput" IN_LIST render_targets)
        message(FATAL_ERROR "Render-only checks must use the harness's exact view library without a controller backend.")
    endif()
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/practice-target-contracts.cmake" CONTENT
        "set(shipping_targets \"${shipping_targets}\")\nset(harness_targets \"${harness_targets}\")\nset(render_targets \"${render_targets}\")\nset(harness_excluded \"${harness_excluded}\")\n")
endif()
