#include <Windows.h>
#include <CommCtrl.h>
#include "Resources.h"

IDD_SETTINGS DIALOGEX 0, 0, 408, 324
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Settings - Overworld"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Settings", IDC_SETTINGS_TITLE, 20, 10, 368, 23
    LTEXT "Make the desktop feel right.", IDC_SETTINGS_SUBTITLE, 20, 34, 368, 15
    CONTROL "", IDC_SETTINGS_TABS, WC_TABCONTROL, TCS_OWNERDRAWFIXED | TCS_FIXEDWIDTH | WS_TABSTOP, 20, 54, 368, 24

    LTEXT "Desktop handoff", IDC_GENERAL_HEADING, 28, 92, 348, 18
    CONTROL "&Automatic game switching", IDC_AUTO_GAME_SWITCHING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 116, 344, 20
    LTEXT "Yield to detected games. Menu + View always lets you request desktop control.", IDC_GENERAL_HINT, 28, 142, 344, 32
    LTEXT "Pause in these apps", IDC_EXCLUSIONS_LABEL, 28, 182, 344, 16
    EDITTEXT IDC_EXCLUSIONS, 28, 204, 344, 40, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT "One executable name per line, for example: MyGame.exe", IDC_EXCLUSIONS_HINT, 28, 248, 344, 15

    LTEXT "Motion profile", IDC_PROFILE_LABEL, 28, 94, 180, 16
    COMBOBOX IDC_MOTION_PROFILE, 210, 91, 162, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Pointer speed (px/s)", IDC_SPEED_LABEL, 28, 120, 180, 16
    EDITTEXT IDC_SPEED, 278, 117, 94, 20, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", 320, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 362, 117, 10, 20
    LTEXT "LB precision (%)", IDC_PRECISION_LABEL, 28, 146, 180, 16
    EDITTEXT IDC_PRECISION, 278, 143, 94, 20, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", 321, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 362, 143, 10, 20
    LTEXT "Scroll speed (units/s)", IDC_SCROLL_LABEL, 28, 172, 180, 16
    EDITTEXT IDC_SCROLL, 278, 169, 94, 20, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", 322, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 362, 169, 10, 20
    LTEXT "Cursor", IDC_STYLE_LABEL, 28, 201, 50, 16
    COMBOBOX IDC_CURSOR_STYLE, 82, 198, 164, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Size (DIP)", IDC_SIZE_LABEL, 28, 229, 64, 16
    EDITTEXT IDC_DIAMETER, 100, 226, 78, 20, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", 327, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 168, 226, 10, 20
    CONTROL "Cursor preview", IDC_CURSOR_PREVIEW, "Static", SS_OWNERDRAW, 258, 195, 114, 63

    LTEXT "Controller keyboard", IDC_TYPING_HEADING, 28, 88, 344, 18
    LTEXT "Selection style", IDC_KEYBOARD_MODE_LABEL, 28, 111, 148, 16
    COMBOBOX IDC_KEYBOARD_INPUT_MODE, 182, 108, 190, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Face buttons: aim, then A / B / X / Y.\r\nOne-handed: flick a group, center, then flick a character.", IDC_TYPING_HINT, 28, 133, 344, 24
    CONTROL "&Word suggestions", IDC_WORD_SUGGESTIONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 158, 344, 18
    CONTROL "&Local voice input", IDC_VOICE_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 179, 344, 18
    LTEXT "Hold right-stick click in the keyboard. Audio stays on this device.", IDC_VOICE_HINT, 28, 201, 344, 16
    LTEXT "Verified tiny.en model (blank uses the default path)", IDC_VOICE_MODEL_LABEL, 28, 222, 344, 12
    EDITTEXT IDC_VOICE_MODEL_PATH, 28, 238, 272, 20, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "&Browse...", IDC_VOICE_BROWSE, 308, 238, 64, 20
    LTEXT "", IDC_VOICE_STATUS, 28, 262, 344, 12

    LTEXT "Fine tuning and experiments", IDC_ADVANCED_HEADING, 28, 88, 344, 18
    LTEXT "Deadzone (%)", IDC_DEADZONE_LABEL, 28, 114, 95, 14
    LTEXT "Left: stop / start", IDC_LEFT_LABEL, 126, 114, 92, 14
    EDITTEXT IDC_LEFT_EXIT, 224, 111, 64, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", 323, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 278, 111, 10, 16
    EDITTEXT IDC_LEFT_ENTER, 300, 111, 72, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", 324, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 362, 111, 10, 16
    LTEXT "Right: stop / start", IDC_RIGHT_LABEL, 126, 138, 92, 14
    EDITTEXT IDC_RIGHT_EXIT, 224, 135, 64, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", 325, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 278, 135, 10, 16
    EDITTEXT IDC_RIGHT_ENTER, 300, 135, 72, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", 326, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 362, 135, 10, 16
    LTEXT "Band speeds (%)", IDC_BANDS_LABEL, 28, 162, 110, 14
    LTEXT "Low", IDC_LOW_LABEL, 142, 162, 25, 14
    EDITTEXT IDC_BAND_LOW, 170, 159, 45, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", 328, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 205, 159, 10, 16
    LTEXT "Mid", IDC_MID_LABEL, 224, 162, 25, 14
    EDITTEXT IDC_BAND_MIDDLE, 250, 159, 45, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", 329, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 285, 159, 10, 16
    LTEXT "High", IDC_HIGH_LABEL, 303, 162, 28, 14
    EDITTEXT IDC_BAND_HIGH, 334, 159, 38, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", 330, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 362, 159, 10, 16
    CONTROL "Keyboard in &native mode (experimental)", IDC_NATIVE_KEYBOARD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 183, 344, 16
    LTEXT "Hold View + Y. Controller input still reaches the game.", IDC_NATIVE_HINT, 28, 202, 344, 12
    CONTROL "Filter native controller na&vigation (experimental)", IDC_NAVIGATION_FILTER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 218, 344, 16
    LTEXT "Injected GAMEPAD keys only. Disable here and Save to turn off.", IDC_FILTER_HINT, 28, 237, 344, 12
    PUSHBUTTON "&Restore pointer", IDC_RESTORE_CURSOR, 28, 252, 118, 18
    PUSHBUTTON "Re&load file", IDC_RELOAD, 154, 252, 80, 18

    EDITTEXT IDC_SETTINGS_RESULT, 20, 277, 368, 18, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Defaults", IDC_DEFAULTS, 20, 300, 62, 20
    DEFPUSHBUTTON "&Save", IDC_APPLY, 264, 300, 58, 20
    PUSHBUTTON "&Close", IDCANCEL, 330, 300, 58, 20
END

#include "BuildInfo.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION OVERWORLD_BUILD_VERSION
 PRODUCTVERSION OVERWORLD_BUILD_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Overworld - controller utility\0"
            VALUE "FileVersion", OVERWORLD_BUILD_LABEL "\0"
            VALUE "ProductName", "Overworld\0"
            VALUE "InternalName", "Overworld\0"
            VALUE "OriginalFilename", "Overworld.exe\0"
            VALUE "ProductVersion", OVERWORLD_BUILD_LABEL "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
